#!/bin/sh
# Safety net: strip any Claude / Anthropic attribution from every commit
# message, no matter which tool (or paste) produced it. This backs up
# .claude/settings.json (attribution disabled) so the trailer can never
# reach a commit again. Never blocks a commit.
#
# Enable on each machine once, after cloning:  git config core.hooksPath .githooks

msg_file="$1"

sed -i -E \
  -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|noreply@anthropic\.com)/d' \
  -e '/noreply@anthropic\.com/d' \
  -e '/[Gg]enerated with .*[Cc]laude/d' \
  -e '/^Claude-Session:.*/d' \
  "$msg_file" 2>/dev/null

exit 0
